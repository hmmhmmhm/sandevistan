{
  "package_id": "com.hmmhmmhm.sandevistan",
  "edition": "202601",
  "name": "SANDEVISTAN",
  "version": "0.2.8",
  "min_app_version": "2.2.10",
  "min_sdk_version": "0.0.16",
  "entrypoint": "index.html",
  "permissions": [
    {
      "name": "location",
      "desc": "Uses your location for maps, weather and location-aware AI tools."
    },
    {
      "name": "network",
      "desc": "Loads weather, map, news, optional routing, and BYOK Realtime AI data.",
      "whitelist": [
        "https://api.open-meteo.com",
        "https://geocoding-api.open-meteo.com",
        "https://api.openai.com",
        "wss://api.openai.com",
        "https://sandevistan-api.hmmhmmhm.workers.dev",
        "https://data.gmanetwork.com",
        "https://feeds.bbci.co.uk",
        "https://news.google.com",
        "https://news.sbs.co.kr",
        "https://rss.ohmynews.com",
        "https://www.dr.dk",
        "https://www.lemonde.fr",
        "https://www.newsis.com",
        "https://www.philstar.com",
        "https://www.rappler.com",
        "https://www.theguardian.com",
        "https://github.com",
        "https://open-meteo.com",
        "https://openmaptiles.org",
        "https://openrouteservice.org",
        "https://platform.openai.com",
        "https://www.geonames.org",
        "https://www.openstreetmap.org",
        "https://react.dev"
      ]
    },
    {
      "name": "g2-microphone",
      "desc": "Uses the G2 microphone only while an Ask AI or Conversate session is active."
    }
  ],
  "supported_languages": [
    "en",
    "de",
    "fr",
    "es",
    "it",
    "zh",
    "ja",
    "ko"
  ]
}
