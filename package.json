{
  "name": "sandevistan",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test": "vitest run --dir src --no-file-parallelism --maxWorkers=1",
    "test:repo": "node --test --test-concurrency=1 tests/repository-copy.test.mjs && node scripts/check-repository-copy.mjs",
    "typecheck": "tsc --noEmit",
    "test:sites": "npm run build && node --test --test-concurrency=1 tests/sites-worker.test.mjs tests/realtime-api.test.mjs tests/ai-web-search-api.test.mjs tests/conversate-api.test.mjs",
    "verify:rss-live": "node scripts/verify-rss-feeds.mjs",
    "qr": "evenhub qr --url \"http://100.127.255.11:4179/hud-canvas-fast?sdk=0.0.16&build=sdk0016-current-audit-20261108\"",
    "qr:hide-black": "evenhub qr --url \"http://100.127.255.11:4179/hud-canvas-fast?sdk=0.0.16&hide=black&build=hide-black-sdk0016-audit-20261108\"",
    "qr:rollback": "evenhub qr --url \"http://100.127.255.11:4179/hud-canvas-fast?sdk=0.0.16&pipeline=1&levels=original&build=rollback-serial-original-sdk0016-audit-20261108\"",
    "qr:pipeline2": "evenhub qr --url \"http://100.127.255.11:4179/hud-canvas-fast?sdk=0.0.16&pipeline=2&build=pipeline-2-sdk0016-audit-20261108\"",
    "qr:pipeline3": "evenhub qr --url \"http://100.127.255.11:4179/hud-canvas-fast?sdk=0.0.16&pipeline=3&build=pipeline-3-sdk0016-audit-20261108\"",
    "qr:pipeline4": "evenhub qr --url \"http://100.127.255.11:4179/hud-canvas-fast?sdk=0.0.16&pipeline=4&build=pipeline-4-sdk0016-audit-20261108\"",
    "qr:palette4": "evenhub qr --url \"http://100.127.255.11:4179/hud-canvas-fast?sdk=0.0.16&pipeline=4&levels=4&build=palette-4-sdk0016-audit-20261108\"",
    "qr:bmp1": "evenhub qr --url \"http://100.127.255.11:4179/hud-canvas-fast?sdk=0.0.16&pipeline=4&format=bmp1&build=bmp1-lz4-sdk0016-audit-20261108\"",
    "pack": "npm run build:evenhub && npm run check:evenhub-network && evenhub pack app.json dist/client --sdk-ver 0.0.16 -o sandevistan.ehpk",
    "typecheck:simulator": "tsc --noEmit -p tsconfig.simulator.json",
    "sim": "evenhub-simulator http://127.0.0.1:4179/hud-canvas-fast --automation-port 9898",
    "build:evenhub": "vite build --mode evenhub && node scripts/prepare-sites-build.mjs",
    "build:api": "node scripts/build-api-worker.mjs",
    "check:evenhub-network": "node scripts/check-evenhub-network.mjs",
    "test:server": "node --test --test-concurrency=1 tests/*.test.mjs",
    "release:check": "npm run typecheck && npm run typecheck:simulator && npm run test:repo && npm run test:docs && npm test && npm run test:server && npm run pack && npm run build:api",
    "test:docs": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.16",
    "@iconify-icons/pixelarticons": "^1.2.5",
    "@iconify-icons/simple-icons": "^1.2.54",
    "@iconify/react": "^6.0.2",
    "@mapbox/vector-tile": "^3.0.0",
    "@vitejs/plugin-react": "5.0.4",
    "pbf": "^5.1.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.5"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "0.2.0",
    "@evenrealities/evenhub-simulator": "0.9.5",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
